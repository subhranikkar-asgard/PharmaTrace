# PharmaTrace — Environment Configuration

# ─── Database ────────────────────────────────────────────────────────────────
# PostgreSQL (preferred)
DATABASE_URL="postgresql://pharmatrace:pharmatrace@localhost:5432/pharmatrace"

# SQLite fallback (comment out the line above and use this if PostgreSQL is not available)
# DATABASE_URL="file:./dev.db"

# ─── Auth ────────────────────────────────────────────────────────────────────
JWT_SECRET="REPLACE_WITH_A_STRONG_RANDOM_SECRET_MINIMUM_32_CHARS"

# ─── Server ──────────────────────────────────────────────────────────────────
PORT=3001

# ─── Frontend ────────────────────────────────────────────────────────────────
FRONTEND_URL="http://localhost:5173"

# ─── Fraud Engine Thresholds ─────────────────────────────────────────────────
# Flag suspicious if required travel speed exceeds this (km/h)
IMPOSSIBLE_TRAVEL_THRESHOLD_KMH=500

# Flag duplicate scan if a scan occurs within this window of the previous scan (seconds)
DUPLICATE_SCAN_WINDOW_SECONDS=300

# Flag excessive scans if scan count exceeds this
EXCESSIVE_SCAN_THRESHOLD=5
